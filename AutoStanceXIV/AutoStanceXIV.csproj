<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.1.0.0</Version>
    <Description>Automatically turns your tank stance on or off (PLD, WAR, DRK, GNB).</Description>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dalamud affiche images/icon.png (à côté de la DLL) comme icône du plugin. -->
    <None Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AutoStanceXIV.Tests" />
  </ItemGroup>
</Project>
